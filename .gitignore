# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Credentials. Never commit these -- auth comes from the environment.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# Captured and downloaded data. Large, regenerable, and not source.
# `data/*` rather than `data/` so the negation below is reachable -- git does
# not descend into a wholly-ignored directory.
data/*
!data/.gitkeep
logs/

# Report artifacts are generated by scripts/; the scripts are the source.
# Committed exceptions are listed explicitly so a reviewer sees the findings
# without running anything.
reports/figures/
!reports/*.md
# Per-run outputs (fill dumps, per-instrument QA JSON) regenerate from the
# scripts. The audit trail -- config_log.jsonl and holdout_log.md -- is kept,
# because it is the evidence that the holdout was read once.
reports/mm/
reports/qa/
notebooks/.ipynb_checkpoints/

# OS / editor / tooling
.DS_Store
*.swp
.idea/
.vscode/
.claude/settings.local.json
